{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated teacher account profile for cloud storage and Google Drive integration.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["teacher", "admin"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Classroom record supporting 10 shared tablets rotating across class periods.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "grade": { "type": "string", "maxLength": 60 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "name", "grade", "teacherName", "createdAt", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Digital Citizenship lesson with 15+ mapped questions across TT 02/2025 competencies.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "topic": { "type": "string", "maxLength": 240 },
        "sourceFileName": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "assignedClassIds": { "type": "array", "description": "Assigned class codes (max 50)." },
        "questions": { "type": "array", "description": "Quiz questions (1 to 30 questions)." },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "title", "topic", "sourceFileName", "summary", "assignedClassIds", "questions", "createdAt", "updatedAt"]
    },
    "AnswerSubmission": {
      "title": "AnswerSubmission",
      "description": "Student team answer and speed+accuracy score submission.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 120 },
        "tabletNumber": { "type": "integer" },
        "groupName": { "type": "string", "maxLength": 80 },
        "lessonId": { "type": "string", "maxLength": 80 },
        "lessonTitle": { "type": "string", "maxLength": 240 },
        "questionId": { "type": "string", "maxLength": 80 },
        "competencyId": { "type": "string", "maxLength": 16 },
        "competencyIds": { "type": "array" },
        "userAnswer": { "type": "string", "maxLength": 1000 },
        "isCorrect": { "type": "boolean" },
        "basePoints": { "type": "integer" },
        "speedBonus": { "type": "integer" },
        "totalPoints": { "type": "integer" },
        "elapsedMs": { "type": "integer" },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "feedbackText": { "type": "string", "maxLength": 500 },
        "explanation": { "type": "string", "maxLength": 1200 },
        "syncedFromOffline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "classId", "groupId", "tabletNumber", "groupName", "lessonId", "lessonTitle", "questionId", "competencyId", "userAnswer", "isCorrect", "basePoints", "speedBonus", "totalPoints", "elapsedMs", "submittedAt", "feedbackText", "explanation", "createdAt"]
    },
    "PushNotification": {
      "title": "PushNotification",
      "description": "Assignment push alert delivered to assigned classrooms.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "lessonId": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 240 },
        "message": { "type": "string", "maxLength": 1000 },
        "readByGroupIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "classId", "lessonId", "title", "message", "readByGroupIds", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Classroom tablet activity event log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 120 },
        "action": { "type": "string", "maxLength": 120 },
        "detail": { "type": "string", "maxLength": 500 },
        "competencyId": { "type": "string", "maxLength": 16 },
        "pointsDelta": { "type": "integer" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "classId", "groupId", "action", "detail", "timestamp", "createdAt"]
    },
    "PublicWorkspace": {
      "title": "PublicWorkspace",
      "description": "Published classroom, lesson, and notification bundle readable by workspace ID (default or share code) for zero-login student tablets.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "classes": { "type": "array", "description": "Published classrooms (max 100)." },
        "lessons": { "type": "array", "description": "Published lessons with questions (max 100)." },
        "notifications": { "type": "array", "description": "Published assignment push notifications (max 50)." },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "classes", "lessons", "createdAt", "updatedAt"]
    },
    "PublicSubmission": {
      "title": "PublicSubmission",
      "description": "Zero-login student team answer submission scoped to a published teacher workspace for live Honor Board and Teacher analytics sync.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "workspaceId": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9_\\-]+$" },
        "classId": { "type": "string", "maxLength": 64 },
        "groupId": { "type": "string", "maxLength": 120 },
        "tabletNumber": { "type": "integer" },
        "groupName": { "type": "string", "maxLength": 80 },
        "lessonId": { "type": "string", "maxLength": 80 },
        "lessonTitle": { "type": "string", "maxLength": 240 },
        "questionId": { "type": "string", "maxLength": 80 },
        "competencyId": { "type": "string", "maxLength": 16 },
        "competencyIds": { "type": "array" },
        "userAnswer": { "type": "string", "maxLength": 1000 },
        "isCorrect": { "type": "boolean" },
        "basePoints": { "type": "integer" },
        "speedBonus": { "type": "integer" },
        "totalPoints": { "type": "integer" },
        "elapsedMs": { "type": "integer" },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "feedbackText": { "type": "string", "maxLength": 500 },
        "explanation": { "type": "string", "maxLength": 1200 },
        "syncedFromOffline": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "workspaceId", "classId", "groupId", "tabletNumber", "groupName", "lessonId", "lessonTitle", "questionId", "competencyId", "userAnswer", "isCorrect", "basePoints", "speedBonus", "totalPoints", "elapsedMs", "submittedAt", "feedbackText", "explanation", "createdAt"]
    },
    "LearnerProfile": {
      "title": "LearnerProfile",
      "description": "Personal home 24-competency self-assessment learner profile linked to verified personal Google email (owner + admin only).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "authType": { "type": "string", "enum": ["google", "guest"] },
        "email": { "type": "string", "maxLength": 200 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "fullName": { "type": "string", "maxLength": 120 },
        "className": { "type": "string", "maxLength": 60 },
        "schoolName": { "type": "string", "maxLength": 160 },
        "gradeBand": { "type": "string", "enum": ["primary", "middle", "high"] },
        "role": { "type": "string", "enum": ["student"] },
        "profileCompleted": { "type": "boolean" },
        "currentLevel": { "type": "integer" },
        "totalXp": { "type": "integer" },
        "bestCombo": { "type": "integer" },
        "totalExercisesDone": { "type": "integer" },
        "totalCorrect": { "type": "integer" },
        "masteryByCompetency": { "type": "object" },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "authType", "fullName", "className", "schoolName", "gradeBand", "role", "profileCompleted", "currentLevel", "totalXp", "bestCombo", "totalExercisesDone", "totalCorrect", "masteryByCompetency", "lastActiveAt", "createdAt", "updatedAt"]
    },
    "TeacherAward": {
      "title": "TeacherAward",
      "description": "Teacher-issued praise badge and bonus XP for home 24-competency learners.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "learnerUid": { "type": "string", "maxLength": 128 },
        "learnerName": { "type": "string", "maxLength": 120 },
        "className": { "type": "string", "maxLength": 60 },
        "schoolName": { "type": "string", "maxLength": 160 },
        "badgeId": { "type": "string", "maxLength": 64 },
        "badgeTitle": { "type": "string", "maxLength": 140 },
        "message": { "type": "string", "maxLength": 500 },
        "bonusXp": { "type": "integer" },
        "awardedByName": { "type": "string", "maxLength": 120 },
        "awardedByEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "learnerUid", "learnerName", "className", "schoolName", "badgeId", "badgeTitle", "message", "bonusXp", "awardedByName", "createdAt"]
    },
    "AssessmentSessionAttempt": {
      "title": "AssessmentSessionAttempt",
      "description": "Recorded home self-assessment session history for teacher analytics and student timeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "learnerUid": { "type": "string", "maxLength": 128 },
        "learnerName": { "type": "string", "maxLength": 120 },
        "className": { "type": "string", "maxLength": 60 },
        "schoolName": { "type": "string", "maxLength": 160 },
        "mode": { "type": "string", "enum": ["diagnostic", "level_challenge", "competency_focus", "variety_sprint", "advanced_pack"] },
        "targetLevel": { "type": "integer" },
        "targetCompetencyId": { "type": "string", "maxLength": 16 },
        "totalQuestions": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "accuracyPercent": { "type": "integer" },
        "xpEarned": { "type": "integer" },
        "maxCombo": { "type": "integer" },
        "competencyIds": { "type": "array" },
        "completedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "learnerUid", "learnerName", "className", "schoolName", "mode", "totalQuestions", "correctCount", "accuracyPercent", "xpEarned", "maxCombo", "competencyIds", "completedAt", "createdAt"]
    },
    "PublicLearnerHonor": {
      "title": "PublicLearnerHonor",
      "description": "Strictly PII-free public honor board entry for home self-assessment learners (no email).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 120 },
        "className": { "type": "string", "maxLength": 60 },
        "schoolName": { "type": "string", "maxLength": 160 },
        "gradeBand": { "type": "string", "enum": ["primary", "middle", "high"] },
        "authType": { "type": "string", "enum": ["google", "guest"] },
        "currentLevel": { "type": "integer" },
        "totalXp": { "type": "integer" },
        "masteredCount": { "type": "integer" },
        "expertCount": { "type": "integer" },
        "accuracyPercent": { "type": "integer" },
        "totalExercisesDone": { "type": "integer" },
        "awardsCount": { "type": "integer" },
        "latestBadgeTitle": { "type": "string", "maxLength": 140 },
        "lastActiveAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["uid", "fullName", "className", "schoolName", "gradeBand", "authType", "currentLevel", "totalXp", "masteredCount", "expertCount", "accuracyPercent", "totalExercisesDone", "awardsCount", "lastActiveAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Teacher user profiles, strictly readable/writable only by owner or admin."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/ClassRoom" },
      "description": "Classrooms owned and edited by the teacher."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "Lessons and 15+ question sets owned and edited by the teacher."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/AnswerSubmission" },
      "description": "Graded student submissions synced to the teacher's Firestore workspace."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/PushNotification" },
      "description": "Assignment push notifications synced to the teacher's Firestore workspace."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Student and teacher activity logs synced to the teacher's Firestore workspace."
    },
    "/publicWorkspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/PublicWorkspace" },
      "description": "Published workspace snapshots (default + teacher share code) fetched without login so student tablets automatically receive teacher classes, lessons, and alerts."
    },
    "/publicWorkspaces/{workspaceId}/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/PublicSubmission" },
      "description": "Zero-login student team answer submissions under a published teacher workspace for live leaderboard and teacher analytics."
    },
    "/learnerProfiles/{userId}": {
      "schema": { "$ref": "#/entities/LearnerProfile" },
      "description": "Personal home 24-competency learner profiles isolated to verified student owner and teacher admin."
    },
    "/guestLearnerProfiles/{guestId}": {
      "schema": { "$ref": "#/entities/LearnerProfile" },
      "description": "Zero-login home 24-competency learner profiles for young students without personal Gmail, monotonically updated and listable only by teacher admin."
    },
    "/teacherAwards/{awardId}": {
      "schema": { "$ref": "#/entities/TeacherAward" },
      "description": "Teacher-issued badges, praise notes, and bonus XP for home learners."
    },
    "/assessmentAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/AssessmentSessionAttempt" },
      "description": "Home 24-competency self-assessment session history readable by student owner and teacher admin."
    },
    "/guestAssessmentAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/AssessmentSessionAttempt" },
      "description": "Zero-login home 24-competency self-assessment session history readable by matching guest profile or teacher admin."
    },
    "/publicLearnerHonor/{userId}": {
      "schema": { "$ref": "#/entities/PublicLearnerHonor" },
      "description": "PII-free public honor board entries for home 24-competency learners (both Google email and zero-login profiles)."
    }
  }
}
