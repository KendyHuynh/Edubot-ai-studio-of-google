rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[A-Za-z0-9_\\-]+$');
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'huynh.nhu.y1601@gmail.com'
      );
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 120
        && data.role in ['teacher', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassRoom(data, classId) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'grade', 'teacherName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'name', 'grade', 'teacherName', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == classId && data.id.size() <= 64
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.grade is string && data.grade.size() <= 60
        && data.teacherName is string && data.teacherName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLesson(data, lessonId) {
      return data.keys().hasAll(['id', 'ownerUid', 'title', 'topic', 'sourceFileName', 'summary', 'assignedClassIds', 'questions', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'title', 'topic', 'sourceFileName', 'summary', 'assignedClassIds', 'questions', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == lessonId && data.id.size() <= 80
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.topic is string && data.topic.size() <= 240
        && data.sourceFileName is string && data.sourceFileName.size() <= 200
        && data.summary is string && data.summary.size() <= 2000
        && data.assignedClassIds is list && data.assignedClassIds.size() <= 50
        && (data.assignedClassIds.size() == 0 || data.assignedClassIds[0] is string)
        && data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 30
        && data.questions[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubmission(data, submissionId) {
      return data.keys().hasAll(['id', 'ownerUid', 'classId', 'groupId', 'tabletNumber', 'groupName', 'lessonId', 'lessonTitle', 'questionId', 'competencyId', 'userAnswer', 'isCorrect', 'basePoints', 'speedBonus', 'totalPoints', 'elapsedMs', 'submittedAt', 'feedbackText', 'explanation', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'classId', 'groupId', 'tabletNumber', 'groupName', 'lessonId', 'lessonTitle', 'questionId', 'competencyId', 'competencyIds', 'userAnswer', 'isCorrect', 'basePoints', 'speedBonus', 'totalPoints', 'elapsedMs', 'submittedAt', 'feedbackText', 'explanation', 'syncedFromOffline', 'createdAt'])
        && data.id is string && data.id == submissionId && data.id.size() <= 80
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.groupId is string && data.groupId.size() <= 120
        && data.tabletNumber is int && data.tabletNumber >= 1 && data.tabletNumber <= 10
        && data.groupName is string && data.groupName.size() <= 80
        && data.lessonId is string && data.lessonId.size() <= 80
        && data.lessonTitle is string && data.lessonTitle.size() <= 240
        && data.questionId is string && data.questionId.size() <= 80
        && data.competencyId is string && data.competencyId.size() <= 16
        && (!('competencyIds' in data) || (data.competencyIds is list && data.competencyIds.size() <= 10 && (data.competencyIds.size() == 0 || data.competencyIds[0] is string)))
        && data.userAnswer is string && data.userAnswer.size() <= 1000
        && data.isCorrect is bool
        && data.basePoints is int && data.basePoints >= 0 && data.basePoints <= 1000
        && data.speedBonus is int && data.speedBonus >= 0 && data.speedBonus <= 1000
        && data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 2000
        && data.elapsedMs is int && data.elapsedMs >= 0
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.feedbackText is string && data.feedbackText.size() <= 500
        && data.explanation is string && data.explanation.size() <= 1200
        && (!('syncedFromOffline' in data) || data.syncedFromOffline is bool)
        && data.createdAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'ownerUid', 'classId', 'lessonId', 'title', 'message', 'readByGroupIds', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'classId', 'lessonId', 'title', 'message', 'readByGroupIds', 'createdAt'])
        && data.id is string && data.id == notificationId && data.id.size() <= 80
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.lessonId is string && data.lessonId.size() <= 80
        && data.title is string && data.title.size() <= 240
        && data.message is string && data.message.size() <= 1000
        && data.readByGroupIds is list && data.readByGroupIds.size() <= 100
        && (data.readByGroupIds.size() == 0 || data.readByGroupIds[0] is string)
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data, logId) {
      return data.keys().hasAll(['id', 'ownerUid', 'classId', 'groupId', 'action', 'detail', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'classId', 'groupId', 'action', 'detail', 'competencyId', 'pointsDelta', 'timestamp', 'createdAt'])
        && data.id is string && data.id == logId && data.id.size() <= 80
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.groupId is string && data.groupId.size() <= 120
        && data.action is string && data.action.size() <= 120
        && data.detail is string && data.detail.size() <= 500
        && (!('competencyId' in data) || (data.competencyId is string && data.competencyId.size() <= 16))
        && (!('pointsDelta' in data) || data.pointsDelta is int)
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.createdAt is timestamp;
    }

    function isValidPublicWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'ownerUid', 'classes', 'lessons', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'classes', 'lessons', 'notifications', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == workspaceId && data.id.size() <= 64
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.classes is list && data.classes.size() <= 100
        && (data.classes.size() == 0 || data.classes[0] is map)
        && data.lessons is list && data.lessons.size() <= 100
        && (data.lessons.size() == 0 || data.lessons[0] is map)
        && (!('notifications' in data) || (data.notifications is list && data.notifications.size() <= 50 && (data.notifications.size() == 0 || data.notifications[0] is map)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicSubmission(data, workspaceId, submissionId) {
      return data.keys().hasAll(['id', 'workspaceId', 'classId', 'groupId', 'tabletNumber', 'groupName', 'lessonId', 'lessonTitle', 'questionId', 'competencyId', 'userAnswer', 'isCorrect', 'basePoints', 'speedBonus', 'totalPoints', 'elapsedMs', 'submittedAt', 'feedbackText', 'explanation', 'createdAt'])
        && data.keys().hasOnly(['id', 'workspaceId', 'classId', 'groupId', 'tabletNumber', 'groupName', 'lessonId', 'lessonTitle', 'questionId', 'competencyId', 'competencyIds', 'userAnswer', 'isCorrect', 'basePoints', 'speedBonus', 'totalPoints', 'elapsedMs', 'submittedAt', 'feedbackText', 'explanation', 'syncedFromOffline', 'createdAt'])
        && data.id is string && data.id == submissionId && data.id.size() <= 128
        && data.workspaceId is string && data.workspaceId == workspaceId && data.workspaceId.size() <= 64
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 64
        && data.groupId is string && data.groupId.size() >= 1 && data.groupId.size() <= 120
        && data.tabletNumber is int && data.tabletNumber >= 1 && data.tabletNumber <= 10
        && data.groupName is string && data.groupName.size() >= 1 && data.groupName.size() <= 80
        && data.lessonId is string && data.lessonId.size() >= 1 && data.lessonId.size() <= 80
        && data.lessonTitle is string && data.lessonTitle.size() <= 240
        && data.questionId is string && data.questionId.size() >= 1 && data.questionId.size() <= 80
        && data.competencyId is string && data.competencyId.size() >= 1 && data.competencyId.size() <= 16
        && (!('competencyIds' in data) || (data.competencyIds is list && data.competencyIds.size() <= 10 && (data.competencyIds.size() == 0 || data.competencyIds[0] is string)))
        && data.userAnswer is string && data.userAnswer.size() <= 1000
        && data.isCorrect is bool
        && data.basePoints is int && data.basePoints >= 0 && data.basePoints <= 1000
        && data.speedBonus is int && data.speedBonus >= 0 && data.speedBonus <= 1000
        && data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 2000
        && data.elapsedMs is int && data.elapsedMs >= 0 && data.elapsedMs <= 3600000
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.feedbackText is string && data.feedbackText.size() <= 500
        && data.explanation is string && data.explanation.size() <= 1200
        && (!('syncedFromOffline' in data) || data.syncedFromOffline is bool)
        && data.createdAt is timestamp;
    }

    // Bootstrapped Admin Registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list, write: if false;
    }

    // Connection Probe Doc
    match /test/connection {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // PII-Isolated Teacher Profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role == 'teacher' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && (isOwner(userId) || isAdmin())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && ((isOwner(userId) && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])) || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Classrooms
    match /classes/{classId} {
      allow get: if isValidId(classId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(classId)
        && isVerifiedUser()
        && isValidClassRoom(incoming(), classId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(classId)
        && isVerifiedUser()
        && isValidClassRoom(incoming(), classId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'grade', 'teacherName', 'updatedAt'])
          || isAdmin()
        );
      allow delete: if isValidId(classId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Lessons & 15+ Questions
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(lessonId)
        && isVerifiedUser()
        && isValidLesson(incoming(), lessonId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(lessonId)
        && isVerifiedUser()
        && isValidLesson(incoming(), lessonId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'topic', 'sourceFileName', 'summary', 'assignedClassIds', 'questions', 'updatedAt'])
          || isAdmin()
        );
      allow delete: if isValidId(lessonId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Student Submissions Synced to Teacher Workspace
    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId)
        && isVerifiedUser()
        && isValidSubmission(incoming(), submissionId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(submissionId)
        && isVerifiedUser()
        && isValidSubmission(incoming(), submissionId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['userAnswer', 'isCorrect', 'basePoints', 'speedBonus', 'totalPoints', 'elapsedMs', 'submittedAt', 'feedbackText', 'explanation', 'syncedFromOffline'])
          || isAdmin()
        );
      allow delete: if isValidId(submissionId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Assignment Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming(), notificationId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming(), notificationId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['readByGroupIds'])
          || isAdmin()
        );
      allow delete: if isValidId(notificationId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidActivityLog(incoming(), logId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isVerifiedUser() && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    // Published Teacher Workspaces (get-only by workspace ID, never listable, teacher/admin writes)
    match /publicWorkspaces/{workspaceId} {
      allow get: if isValidId(workspaceId);
      allow list: if false;
      allow create: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidPublicWorkspace(incoming(), workspaceId)
        && incoming().ownerUid == request.auth.uid
        && (workspaceId != 'default' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(workspaceId)
        && isVerifiedUser()
        && isValidPublicWorkspace(incoming(), workspaceId)
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && (workspaceId != 'default' || isAdmin())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['classes', 'lessons', 'notifications', 'updatedAt'])
          || isAdmin()
        );
      allow delete: if isValidId(workspaceId)
        && isVerifiedUser()
        && (existing().ownerUid == request.auth.uid || isAdmin())
        && (workspaceId != 'default' || isAdmin());

      // Zero-login student answer submissions scoped to a published teacher workspace
      match /submissions/{submissionId} {
        allow get: if isValidId(workspaceId) && isValidId(submissionId);
        allow list: if isValidId(workspaceId)
          && resource.data.workspaceId == workspaceId
          && request.query.limit <= 300;
        allow create: if isValidId(workspaceId)
          && isValidId(submissionId)
          && isValidPublicSubmission(incoming(), workspaceId, submissionId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/publicWorkspaces/$(workspaceId));
        allow update: if isValidId(workspaceId)
          && isValidId(submissionId)
          && isAdmin()
          && isValidPublicSubmission(incoming(), workspaceId, submissionId)
          && incoming().id == existing().id
          && incoming().workspaceId == existing().workspaceId
          && incoming().createdAt == existing().createdAt;
        allow delete: if isValidId(workspaceId) && isValidId(submissionId) && isAdmin();
      }
    }

    // Personal Home Self-Assessment Learner Profiles (PII-isolated: owner + admin only)
    function isValidLearnerProfile(data, userId) {
      return data.keys().hasAll(['uid', 'authType', 'fullName', 'className', 'schoolName', 'gradeBand', 'role', 'profileCompleted', 'currentLevel', 'totalXp', 'bestCombo', 'totalExercisesDone', 'totalCorrect', 'masteryByCompetency', 'lastActiveAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'authType', 'email', 'photoUrl', 'fullName', 'className', 'schoolName', 'gradeBand', 'role', 'profileCompleted', 'currentLevel', 'totalXp', 'bestCombo', 'totalExercisesDone', 'totalCorrect', 'masteryByCompetency', 'lastActiveAt', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.authType in ['google', 'guest']
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 60
        && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 160
        && data.gradeBand in ['primary', 'middle', 'high']
        && data.role == 'student'
        && data.profileCompleted is bool
        && data.currentLevel is int && data.currentLevel >= 1 && data.currentLevel <= 4
        && data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 1000000
        && data.bestCombo is int && data.bestCombo >= 0 && data.bestCombo <= 1000
        && data.totalExercisesDone is int && data.totalExercisesDone >= 0 && data.totalExercisesDone <= 100000
        && data.totalCorrect is int && data.totalCorrect >= 0 && data.totalCorrect <= 100000
        && data.masteryByCompetency is map
        && data.lastActiveAt is string && data.lastActiveAt.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTeacherAward(data, awardId) {
      return data.keys().hasAll(['id', 'learnerUid', 'learnerName', 'className', 'schoolName', 'badgeId', 'badgeTitle', 'message', 'bonusXp', 'awardedByName', 'createdAt'])
        && data.keys().hasOnly(['id', 'learnerUid', 'learnerName', 'className', 'schoolName', 'badgeId', 'badgeTitle', 'message', 'bonusXp', 'awardedByName', 'awardedByEmail', 'createdAt'])
        && data.id is string && data.id == awardId && data.id.size() <= 80
        && data.learnerUid is string && data.learnerUid.size() >= 1 && data.learnerUid.size() <= 128
        && data.learnerName is string && data.learnerName.size() <= 120
        && data.className is string && data.className.size() <= 60
        && data.schoolName is string && data.schoolName.size() <= 160
        && data.badgeId is string && data.badgeId.size() <= 64
        && data.badgeTitle is string && data.badgeTitle.size() >= 1 && data.badgeTitle.size() <= 140
        && data.message is string && data.message.size() <= 500
        && data.bonusXp is int && data.bonusXp >= 0 && data.bonusXp <= 500
        && data.awardedByName is string && data.awardedByName.size() <= 120
        && (!('awardedByEmail' in data) || (data.awardedByEmail is string && data.awardedByEmail.size() <= 200))
        && data.createdAt is timestamp;
    }

    function isValidGuestId(id) {
      return id is string && id.size() >= 10 && id.size() <= 96 && id.matches('^guest-[A-Za-z0-9_\\-]+$');
    }

    match /learnerProfiles/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidLearnerProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidLearnerProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == 'student'
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Zero-login Home Self-Assessment Learner Profiles (for young students without personal Gmail)
    // Strictly separated from verified Google learnerProfiles; monotonic XP guard prevents resets; list is Admin-only.
    match /guestLearnerProfiles/{guestId} {
      allow get: if isValidGuestId(guestId);
      allow list: if isAdmin();
      allow create: if isValidGuestId(guestId)
        && incoming().authType == 'guest'
        && isValidLearnerProfile(incoming(), guestId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidGuestId(guestId)
        && incoming().authType == 'guest'
        && existing().authType == 'guest'
        && isValidLearnerProfile(incoming(), guestId)
        && incoming().uid == existing().uid
        && incoming().role == 'student'
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().totalXp >= existing().totalXp
            && incoming().totalExercisesDone >= existing().totalExercisesDone
          )
        );
      allow delete: if isValidGuestId(guestId) && isAdmin();
    }

    match /teacherAwards/{awardId} {
      allow get: if isValidId(awardId) && (
        isAdmin()
        || (isVerifiedUser() && existing().learnerUid == request.auth.uid)
        || isValidGuestId(existing().learnerUid)
      );
      allow list: if isAdmin()
        || (isVerifiedUser() && resource.data.learnerUid == request.auth.uid)
        || (isValidGuestId(resource.data.learnerUid) && request.query.limit <= 50);
      allow create: if isValidId(awardId)
        && isAdmin()
        && isValidTeacherAward(incoming(), awardId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(awardId) && isAdmin();
    }

    function isValidAssessmentAttempt(data, attemptId) {
      return data.keys().hasAll(['id', 'learnerUid', 'learnerName', 'className', 'schoolName', 'mode', 'totalQuestions', 'correctCount', 'accuracyPercent', 'xpEarned', 'maxCombo', 'competencyIds', 'completedAt', 'createdAt'])
        && data.keys().hasOnly(['id', 'learnerUid', 'learnerName', 'className', 'schoolName', 'mode', 'targetLevel', 'targetCompetencyId', 'totalQuestions', 'correctCount', 'accuracyPercent', 'xpEarned', 'maxCombo', 'competencyIds', 'completedAt', 'createdAt'])
        && data.id is string && data.id == attemptId && data.id.size() <= 80
        && data.learnerUid is string && data.learnerUid.size() >= 1 && data.learnerUid.size() <= 128
        && data.learnerName is string && data.learnerName.size() <= 120
        && data.className is string && data.className.size() <= 60
        && data.schoolName is string && data.schoolName.size() <= 160
        && data.mode in ['diagnostic', 'level_challenge', 'competency_focus', 'variety_sprint', 'advanced_pack']
        && (!('targetLevel' in data) || (data.targetLevel is int && data.targetLevel >= 1 && data.targetLevel <= 4))
        && (!('targetCompetencyId' in data) || (data.targetCompetencyId is string && data.targetCompetencyId.size() <= 16))
        && data.totalQuestions is int && data.totalQuestions >= 0 && data.totalQuestions <= 100
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100
        && data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100
        && data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 10000
        && data.maxCombo is int && data.maxCombo >= 0 && data.maxCombo <= 100
        && data.competencyIds is list && data.competencyIds.size() <= 24
        && (data.competencyIds.size() == 0 || data.competencyIds[0] is string)
        && data.completedAt is string && data.completedAt.size() <= 64
        && data.createdAt is timestamp;
    }

    match /assessmentAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (isAdmin() || (isVerifiedUser() && existing().learnerUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.learnerUid == request.auth.uid);
      allow create: if isValidId(attemptId)
        && isVerifiedUser()
        && incoming().learnerUid == request.auth.uid
        && isValidAssessmentAttempt(incoming(), attemptId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    match /guestAssessmentAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && (isAdmin() || isValidGuestId(existing().learnerUid));
      allow list: if isAdmin() || (isValidGuestId(resource.data.learnerUid) && request.query.limit <= 40);
      allow create: if isValidId(attemptId)
        && isValidGuestId(incoming().learnerUid)
        && isValidAssessmentAttempt(incoming(), attemptId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    // Strictly PII-free Public Home Self-Assessment Honor Entry (NO email or photoUrl permitted!)
    function isValidPublicLearnerHonor(data, userId) {
      return data.keys().hasAll(['uid', 'fullName', 'className', 'schoolName', 'gradeBand', 'authType', 'currentLevel', 'totalXp', 'masteredCount', 'expertCount', 'accuracyPercent', 'totalExercisesDone', 'awardsCount', 'lastActiveAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'fullName', 'className', 'schoolName', 'gradeBand', 'authType', 'currentLevel', 'totalXp', 'masteredCount', 'expertCount', 'accuracyPercent', 'totalExercisesDone', 'awardsCount', 'latestBadgeTitle', 'lastActiveAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 60
        && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 160
        && data.gradeBand in ['primary', 'middle', 'high']
        && data.authType in ['google', 'guest']
        && data.currentLevel is int && data.currentLevel >= 1 && data.currentLevel <= 4
        && data.totalXp is int && data.totalXp >= 0 && data.totalXp <= 1000000
        && data.masteredCount is int && data.masteredCount >= 0 && data.masteredCount <= 24
        && data.expertCount is int && data.expertCount >= 0 && data.expertCount <= 24
        && data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100
        && data.totalExercisesDone is int && data.totalExercisesDone >= 0 && data.totalExercisesDone <= 100000
        && data.awardsCount is int && data.awardsCount >= 0 && data.awardsCount <= 1000
        && (!('latestBadgeTitle' in data) || (data.latestBadgeTitle is string && data.latestBadgeTitle.size() <= 140))
        && data.lastActiveAt is string && data.lastActiveAt.size() <= 64
        && data.updatedAt is timestamp;
    }

    match /publicLearnerHonor/{userId} {
      allow get: if isValidId(userId);
      allow list: if request.query.limit <= 200;
      allow create: if isValidId(userId)
        && isValidPublicLearnerHonor(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          (isVerifiedUser() && (isOwner(userId) || isAdmin()))
          || (isValidGuestId(userId) && incoming().authType == 'guest')
        );
      allow update: if isValidId(userId)
        && isValidPublicLearnerHonor(incoming(), userId)
        && incoming().updatedAt == request.time
        && (
          (isVerifiedUser() && (isOwner(userId) || isAdmin()))
          || (
            isValidGuestId(userId)
            && incoming().authType == 'guest'
            && existing().authType == 'guest'
            && incoming().totalXp >= existing().totalXp
          )
        );
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
